{
  "name": "serverwise",
  "version": "0.1.0",
  "private": true,
  "description": "ServerWise — AI-Powered Server & Infrastructure Management",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
