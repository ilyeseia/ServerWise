    "@prisma/client": "7.10.1",
    "@radix-ui/react-slot": "1.5.0",
    "better-auth": "1.7.11",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.60.0",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "next-themes": "0.4.6",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
