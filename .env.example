# Copy to `.env` and fill in. NEVER commit `.env`.

# --- Database (used by docker compose) ---
POSTGRES_USER=serverwise
POSTGRES_DB=serverwise
# Generate a strong value, e.g.:  openssl rand -base64 32   (avoid characters that need URL-encoding)
POSTGRES_PASSWORD=CHANGE_ME

# --- Local development (host `pnpm dev`, DB from compose.dev.yml) ---
DATABASE_URL=postgresql://serverwise:CHANGE_ME@localhost:5432/serverwise

# --- Authentication (Stage 2) ---
# Signs/encrypts auth data. REQUIRED in production, at least 32 characters. Generate with:
#   openssl rand -base64 32
# Changing it signs everyone out. Never commit the real value.
AUTH_SECRET=
# Extra browser origins allowed to call /api/auth (comma separated), besides APP_URL.
# AUTH_TRUSTED_ORIGINS=https://serverwise.example.ts.net
# Owners must enrol TOTP before using the app. Default: true in production, false otherwise.
# REQUIRE_OWNER_2FA=true

# --- Application ---
# The URL users open in the browser. Use https:// in production so cookies are marked Secure.
APP_URL=http://localhost:3000
LOG_LEVEL=info
# Docker network that the tsdproxy container is attached to (must already exist).
# TSDPROXY_NETWORK=tsdproxy_default
# APP_PORT=3000
# DB_PORT=5432
