// ServerWise data model.
// Stage 1: AppSetting. Stage 2: authentication (Better Auth core + admin + twoFactor + rateLimit),
// audit log. Business tables arrive with their stages.
//
// Better Auth models (User, Session, Account, Verification, TwoFactor, RateLimit) must keep the
// field names below: the Prisma adapter addresses them by name.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Key/value application settings (validated per key in src/modules/settings).
model AppSetting {
  key       String   @id @db.VarChar(100)
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("app_setting")
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  // admin plugin
  role       String?
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime? @db.Timestamptz(3)

  // twoFactor plugin
  twoFactorEnabled Boolean? @default(false)

  // ServerWise security fields
  mustChangePassword Boolean   @default(false)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime? @db.Timestamptz(3)

  sessions   Session[]
  accounts   Account[]
  twoFactors TwoFactor[]

  // CRM ownership (set null when a user is removed so customer history is kept)
  ownedLeads        Lead[]     @relation("LeadOwner")
  assignedFollowUps FollowUp[] @relation("FollowUpAssignee")

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime @db.Timestamptz(3)
  token          String   @unique
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime? @db.Timestamptz(3)
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

/// Append-only security/business audit trail. UPDATE and DELETE are blocked by a database trigger
/// (see the migration). No foreign keys, so history survives user deletion.
model AuditLog {
  id         String   @id @default(uuid(7))
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  actorId    String?
  actorEmail String?
  action     String   @db.VarChar(100)
  entityType String?  @db.VarChar(100)
  entityId   String?
  ip         String?
  userAgent  String?
  metadata   Json?

  @@index([createdAt(sort: Desc)])
  @@index([action])
  @@index([actorId])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------------------------
// CRM (Stage 3)
// ---------------------------------------------------------------------------------------------

enum CustomerType {
  individual
  business
}

/// prospect: created from an enquiry; active: has won work; archived: hidden, history kept.
enum CustomerStatus {
  prospect
  active
  archived
}

enum Language {
  ar
  fr
}

enum LeadStatus {
  new
  contacted
  qualified
  proposal
  won
  lost
}

enum LeadSource {
  referral
  phone
  whatsapp
  facebook
  ouedkniss
  walk_in
  website
  other
}

enum FollowUpStatus {
  open
  done
  cancelled
}

enum CommunicationChannel {
  call
  whatsapp
  sms
  email
  visit
  other
}

enum CommunicationDirection {
  inbound
  outbound
}

enum RequirementsStatus {
  draft
  complete
}

model Customer {
  id                String         @id @default(uuid(7))
  type              CustomerType
  /// Display name: the person, or the trade name of a business.
  name              String         @db.VarChar(200)
  /// Registered/legal name of a business (optional).
  legalName         String?        @db.VarChar(200)
  /// Algerian tax identification number (NIF) for businesses (optional).
  taxId             String?        @db.VarChar(40)
  phone             String?        @db.VarChar(30)
  email             String?        @db.VarChar(254)
  /// Algerian wilaya code 1..58 (19 = Sétif). Range enforced by a CHECK constraint.
  wilayaCode        Int?
  address           String?        @db.VarChar(300)
  preferredLanguage Language       @default(ar)
  status            CustomerStatus @default(prospect)
  notes             String?        @db.VarChar(2000)
  archivedAt        DateTime?      @db.Timestamptz(3)
  createdById       String?
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @default(now()) @updatedAt @db.Timestamptz(3)

  contacts       Contact[]
  leads          Lead[]
  followUps      FollowUp[]
  communications Communication[]

  @@index([name])
  @@index([phone])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("customer")
}

model Contact {
  id         String   @id @default(uuid(7))
  customerId String
  name       String   @db.VarChar(200)
  jobTitle   String?  @db.VarChar(120)
  phone      String?  @db.VarChar(30)
  email      String?  @db.VarChar(254)
  /// At most one primary contact per customer (partial unique index in the migration).
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("contact")
}

model Lead {
  id           String     @id @default(uuid(7))
  customerId   String
  title        String     @db.VarChar(200)
  source       LeadSource @default(other)
  status       LeadStatus @default(new)
  /// Customer budget range in DZD (money is always numeric, never float).
  budgetMinDzd Decimal?   @db.Decimal(14, 2)
  budgetMaxDzd Decimal?   @db.Decimal(14, 2)
  ownerId      String?
  notes        String?    @db.VarChar(2000)
  /// Required when status is lost (CHECK constraint).
  lostReason   String?    @db.VarChar(300)
  closedAt     DateTime?  @db.Timestamptz(3)
  createdById  String?
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @default(now()) @updatedAt @db.Timestamptz(3)

  customer        Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  owner           User?                 @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  followUps       FollowUp[]
  communications  Communication[]
  requirements    RequirementsResponse?
  recommendations Recommendation[]
  quotes          Quote[]

  @@index([customerId])
  @@index([status])
  @@index([ownerId])
  @@index([createdAt(sort: Desc)])
  @@map("lead")
}

model FollowUp {
  id            String         @id @default(uuid(7))
  customerId    String
  leadId        String?
  title         String         @db.VarChar(200)
  dueAt         DateTime       @db.Timestamptz(3)
  status        FollowUpStatus @default(open)
  assignedToId  String?
  notes         String?        @db.VarChar(1000)
  completedAt   DateTime?      @db.Timestamptz(3)
  completedById String?
  createdById   String?
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @default(now()) @updatedAt @db.Timestamptz(3)

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lead       Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  assignedTo User?    @relation("FollowUpAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([status, dueAt])
  @@index([assignedToId, status])
  @@index([customerId])
  @@index([leadId])
  @@map("follow_up")
}

/// Append-only conversation log. There is deliberately no update/delete path in the application.
model Communication {
  id          String                 @id @default(uuid(7))
  customerId  String
  leadId      String?
  channel     CommunicationChannel
  direction   CommunicationDirection
  occurredAt  DateTime               @db.Timestamptz(3)
  summary     String                 @db.VarChar(2000)
  createdById String?
  createdAt   DateTime               @default(now()) @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lead     Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([customerId, occurredAt(sort: Desc)])
  @@index([leadId])
  @@map("communication")
}

/// Answers to the requirements questionnaire for one lead. `version` pins the questionnaire
/// definition the answers were given against, so old answers always render correctly.
model RequirementsResponse {
  id          String             @id @default(uuid(7))
  leadId      String             @unique
  version     Int
  answers     Json
  status      RequirementsStatus @default(draft)
  updatedById String?
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @default(now()) @updatedAt @db.Timestamptz(3)

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("requirements_response")
}

// ---------------------------------------------------------------------------------------------
// Hardware catalog, suppliers and the advisor (Stage 4)
// ---------------------------------------------------------------------------------------------

enum ProductCategory {
  mini_pc
  refurbished_desktop
  nas
  workstation
  server
}

enum GpuClass {
  none
  integrated
  dedicated
}

enum NoiseClass {
  silent
  quiet
  normal
  loud
}

enum SupplierKind {
  retailer
  marketplace_seller
  manufacturer
  importer
  individual
}

enum OfferCondition {
  new
  refurbished
  used
}

enum Availability {
  in_stock
  limited
  on_order
  out_of_stock
  unknown
}

enum VerificationStatus {
  unverified
  verified
  rejected
}

/// A hardware model. Every spec is optional: an empty spec means "unknown", never a guess.
model Product {
  id       String          @id @default(uuid(7))
  category ProductCategory
  brand    String          @db.VarChar(80)
  model    String          @db.VarChar(120)

  cpuModel           String?     @db.VarChar(120)
  cpuCores           Int?
  /// PassMark "CPU Mark" (multi-thread) copied from the public benchmark; see cpuBenchmarkSource.
  cpuBenchmark       Int?
  cpuBenchmarkSource String?     @db.VarChar(300)
  ramGb              Int?
  ramMaxGb           Int?
  /// Drive slots (SATA bays and M.2) available for data.
  storageSlots       Int?
  /// Largest total capacity the model can hold, in TB.
  storageMaxTb       Decimal?    @db.Decimal(8, 2)
  lanPorts           Int?
  /// Speed of the fastest network port in Mbit/s (1000, 2500, 10000...).
  lanSpeedMbps       Int?
  hasWifi            Boolean?
  gpuClass           GpuClass?
  noiseClass         NoiseClass?
  idleWatts          Int?
  maxWatts           Int?
  ecc                Boolean?
  /// Manufacturer documentation the specs were taken from.
  specsSource        String?     @db.VarChar(300)
  notes              String?     @db.VarChar(2000)

  active      Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  offers     SupplierOffer[]
  quoteLines QuoteLine[]

  @@index([category])
  @@index([brand, model])
  @@map("product")
}

model Supplier {
  id         String       @id @default(uuid(7))
  name       String       @unique @db.VarChar(160)
  kind       SupplierKind
  wilayaCode Int?
  phone      String?      @db.VarChar(30)
  url        String?      @db.VarChar(300)
  notes      String?      @db.VarChar(1000)
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime     @default(now()) @updatedAt @db.Timestamptz(3)

  offers SupplierOffer[]

  @@map("supplier")
}

/// One observation of a price at a supplier. Immutable (database trigger): a price change is a
/// NEW row, so the price history is preserved. Only verification fields and notes can change.
model SupplierOffer {
  id                 String             @id @default(uuid(7))
  productId          String
  supplierId         String
  priceDzd           Decimal            @db.Decimal(14, 2)
  condition          OfferCondition
  availability       Availability       @default(unknown)
  warrantyMonths     Int?
  /// Wilaya where the item can be collected (1..58).
  locationWilayaCode Int?
  /// Evidence: a link to the listing/page, or a reference for a manual quotation. One is required.
  sourceUrl          String?            @db.VarChar(500)
  quoteReference     String?            @db.VarChar(160)
  /// When the price was observed at the source.
  checkedAt          DateTime           @db.Timestamptz(3)
  verificationStatus VerificationStatus @default(unverified)
  verifiedAt         DateTime?          @db.Timestamptz(3)
  verifiedById       String?
  notes              String?            @db.VarChar(1000)
  createdById        String?
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  supplier   Supplier    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  quoteLines QuoteLine[]

  @@index([productId, checkedAt(sort: Desc)])
  @@index([supplierId])
  @@index([verificationStatus])
  @@map("supplier_offer")
}

/// A saved advisor run: an immutable snapshot of the inputs, the weights and the full explained
/// ranking, so a recommendation can be shown or quoted later exactly as it was produced.
model Recommendation {
  id                  String   @id @default(uuid(7))
  leadId              String
  engineVersion       Int
  requirementsVersion Int
  inputs              Json
  results             Json
  createdById         String?
  createdAt           DateTime @default(now()) @db.Timestamptz(3)

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Restrict)

  @@index([leadId, createdAt(sort: Desc)])
  @@map("recommendation")
}

enum QuoteRevisionStatus {
  draft
  issued
  accepted
  rejected
  superseded
}

enum QuoteLineKind {
  hardware
  labor
  service
  other
}

/// A quotation for a lead. The content lives in revisions; an issued revision is an immutable
/// snapshot (see the quote_* triggers), a change is a new revision.
model Quote {
  id          String   @id @default(uuid(7))
  /// Human-facing, unique, gap-tolerant number such as Q-2026-0001.
  number      String   @unique @db.VarChar(20)
  leadId      String
  title       String   @db.VarChar(200)
  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  lead      Lead            @relation(fields: [leadId], references: [id], onDelete: Restrict)
  revisions QuoteRevision[]

  @@index([leadId])
  @@index([createdAt(sort: Desc)])
  @@map("quote")
}

/// Per-year counter used to allocate quote numbers atomically.
model QuoteCounter {
  year Int @id
  last Int

  @@map("quote_counter")
}

model QuoteRevision {
  id           String              @id @default(uuid(7))
  quoteId      String
  number       Int
  status       QuoteRevisionStatus @default(draft)
  /// Terms / notes shown to the customer.
  notes        String?             @db.VarChar(2000)
  /// Set when issued: issuedAt + the configured validity.
  validUntil   DateTime?           @db.Timestamptz(3)
  issuedAt     DateTime?           @db.Timestamptz(3)
  issuedById   String?
  /// Totals are produced by the deterministic calculator (src/modules/quotes/calc.ts).
  subtotalDzd  Decimal             @default(0) @db.Decimal(14, 2)
  discountDzd  Decimal             @default(0) @db.Decimal(14, 2)
  taxDzd       Decimal             @default(0) @db.Decimal(14, 2)
  totalDzd     Decimal             @default(0) @db.Decimal(14, 2)
  /// Frozen at issue: company, customer, lines with price evidence, calculation, engine version.
  snapshot     Json?
  decidedAt    DateTime?           @db.Timestamptz(3)
  decidedById  String?
  decisionNote String?             @db.VarChar(500)
  createdById  String?
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime            @default(now()) @updatedAt @db.Timestamptz(3)

  quote Quote       @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  lines QuoteLine[]

  @@unique([quoteId, number])
  @@index([status])
  @@map("quote_revision")
}

model QuoteLine {
  id          String        @id @default(uuid(7))
  revisionId  String
  position    Int
  kind        QuoteLineKind
  description String        @db.VarChar(300)
  quantity    Decimal       @db.Decimal(12, 3)
  unitPrice   Decimal       @db.Decimal(14, 2)
  discountPct Decimal       @default(0) @db.Decimal(5, 2)
  taxRatePct  Decimal       @default(0) @db.Decimal(5, 2)
  /// What the line costs the business per unit; unknown (null) is never guessed.
  unitCost    Decimal?      @db.Decimal(14, 2)
  productId   String?
  /// The price observation the cost came from (evidence), for hardware lines.
  offerId     String?

  revision QuoteRevision  @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  product  Product?       @relation(fields: [productId], references: [id], onDelete: Restrict)
  offer    SupplierOffer? @relation(fields: [offerId], references: [id], onDelete: Restrict)

  @@unique([revisionId, position])
  @@index([productId])
  @@index([offerId])
  @@map("quote_line")
}
