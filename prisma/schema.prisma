// ServerWise data model.
// Stage 1: AppSetting. Stage 2: authentication (Better Auth core + admin + twoFactor + rateLimit),
// audit log. Business tables arrive with their stages.
//
// Better Auth models (User, Session, Account, Verification, TwoFactor, RateLimit) must keep the
// field names below: the Prisma adapter addresses them by name.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Key/value application settings (validated per key in src/modules/settings).
model AppSetting {
  key       String   @id @db.VarChar(100)
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("app_setting")
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  // admin plugin
  role       String?
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime? @db.Timestamptz(3)

  // twoFactor plugin
  twoFactorEnabled Boolean? @default(false)

  // ServerWise security fields
  mustChangePassword Boolean   @default(false)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime? @db.Timestamptz(3)

  sessions   Session[]
  accounts   Account[]
  twoFactors TwoFactor[]

  // CRM ownership (set null when a user is removed so customer history is kept)
  ownedLeads        Lead[]                @relation("LeadOwner")
  managedProjects   Project[]             @relation("ProjectManager")
  assignedTickets   Ticket[]              @relation("TicketAssignee")
  assignedSchedules MaintenanceSchedule[] @relation("ScheduleAssignee")
  assignedTasks     Task[]                @relation("TaskAssignee")
  assignedFollowUps FollowUp[]            @relation("FollowUpAssignee")
  approvedDeployments DeploymentApproval[] @relation("DeploymentApprovalApprover")
  rejectedDeployments DeploymentApproval[] @relation("DeploymentApprovalRejecter")

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime @db.Timestamptz(3)
  token          String   @unique
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime? @db.Timestamptz(3)
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

/// Append-only security/business audit trail. UPDATE and DELETE are blocked by a database trigger
/// (see the migration). No foreign keys, so history survives user deletion.
model AuditLog {
  id         String   @id @default(uuid(7))
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  actorId    String?
  actorEmail String?
  action     String   @db.VarChar(100)
  entityType String?  @db.VarChar(100)
  entityId   String?
  ip         String?
  userAgent  String?
  metadata   Json?

  @@index([createdAt(sort: Desc)])
  @@index([action])
  @@index([actorId])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------------------------
// CRM (Stage 3)
// ---------------------------------------------------------------------------------------------

enum CustomerType {
  individual
  business
}

/// prospect: created from an enquiry; active: has won work; archived: hidden, history kept.
enum CustomerStatus {
  prospect
  active
  archived
}

enum Language {
  ar
  fr
}

enum LeadStatus {
  new
  contacted
  qualified
  proposal
  won
  lost
}

enum LeadSource {
  referral
  phone
  whatsapp
  facebook
  ouedkniss
  walk_in
  website
  other
}

enum FollowUpStatus {
  open
  done
  cancelled
}

enum CommunicationChannel {
  call
  whatsapp
  sms
  email
  visit
  other
}

enum CommunicationDirection {
  inbound
  outbound
}

enum RequirementsStatus {
  draft
  complete
}

model Customer {
  id                String         @id @default(uuid(7))
  type              CustomerType
  /// Display name: the person, or the trade name of a business.
  name              String         @db.VarChar(200)
  /// Registered/legal name of a business (optional).
  legalName         String?        @db.VarChar(200)
  /// Algerian tax identification number (NIF) for businesses (optional).
  taxId             String?        @db.VarChar(40)
  phone             String?        @db.VarChar(30)
  email             String?        @db.VarChar(254)
  /// Algerian wilaya code 1..58 (19 = Sétif). Range enforced by a CHECK constraint.
  wilayaCode        Int?
  address           String?        @db.VarChar(300)
  preferredLanguage Language       @default(ar)
  status            CustomerStatus @default(prospect)
  notes             String?        @db.VarChar(2000)
  archivedAt        DateTime?      @db.Timestamptz(3)
  createdById       String?
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @default(now()) @updatedAt @db.Timestamptz(3)

  contacts       Contact[]
  leads          Lead[]
  followUps      FollowUp[]
  assets         Asset[]
  contracts      MaintenanceContract[]
  tickets        Ticket[]
  serviceReports ServiceReport[]
  backupPolicies BackupPolicy[]
  remotePlans    RemoteAccessPlan[]
  communications Communication[]
  deploymentJobs DeploymentJob[]
  deploymentProviders DeploymentProvider[]

  @@index([name])
  @@index([phone])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("customer")
}

model Contact {
  id         String   @id @default(uuid(7))
  customerId String
  name       String   @db.VarChar(200)
  jobTitle   String?  @db.VarChar(120)
  phone      String?  @db.VarChar(30)
  email      String?  @db.VarChar(254)
  /// At most one primary contact per customer (partial unique index in the migration).
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("contact")
}

model Lead {
  id           String     @id @default(uuid(7))
  customerId   String
  title        String     @db.VarChar(200)
  source       LeadSource @default(other)
  status       LeadStatus @default(new)
  /// Customer budget range in DZD (money is always numeric, never float).
  budgetMinDzd Decimal?   @db.Decimal(14, 2)
  budgetMaxDzd Decimal?   @db.Decimal(14, 2)
  ownerId      String?
  notes        String?    @db.VarChar(2000)
  /// Required when status is lost (CHECK constraint).
  lostReason   String?    @db.VarChar(300)
  closedAt     DateTime?  @db.Timestamptz(3)
  createdById  String?
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @default(now()) @updatedAt @db.Timestamptz(3)

  customer        Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  owner           User?                 @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  followUps       FollowUp[]
  communications  Communication[]
  requirements    RequirementsResponse?
  recommendations Recommendation[]
  quotes          Quote[]
  projects        Project[]

  @@index([customerId])
  @@index([status])
  @@index([ownerId])
  @@index([createdAt(sort: Desc)])
  @@index([closedAt])
  @@map("lead")
}

model FollowUp {
  id            String         @id @default(uuid(7))
  customerId    String
  leadId        String?
  title         String         @db.VarChar(200)
  dueAt         DateTime       @db.Timestamptz(3)
  status        FollowUpStatus @default(open)
  assignedToId  String?
  notes         String?        @db.VarChar(1000)
  completedAt   DateTime?      @db.Timestamptz(3)
  completedById String?
  createdById   String?
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @default(now()) @updatedAt @db.Timestamptz(3)

  customer             Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lead                 Lead?                 @relation(fields: [leadId], references: [id], onDelete: SetNull)
  assignedTo           User?                 @relation("FollowUpAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  maintenanceReminders MaintenanceReminder[]

  @@index([status, dueAt])
  @@index([assignedToId, status])
  @@index([customerId])
  @@index([leadId])
  @@map("follow_up")
}

/// Append-only conversation log. There is deliberately no update/delete path in the application.
model Communication {
  id          String                 @id @default(uuid(7))
  customerId  String
  leadId      String?
  channel     CommunicationChannel
  direction   CommunicationDirection
  occurredAt  DateTime               @db.Timestamptz(3)
  summary     String                 @db.VarChar(2000)
  createdById String?
  createdAt   DateTime               @default(now()) @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lead     Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([customerId, occurredAt(sort: Desc)])
  @@index([leadId])
  @@map("communication")
}

/// Answers to the requirements questionnaire for one lead. `version` pins the questionnaire
/// definition the answers were given against, so old answers always render correctly.
model RequirementsResponse {
  id          String             @id @default(uuid(7))
  leadId      String             @unique
  version     Int
  answers     Json
  status      RequirementsStatus @default(draft)
  updatedById String?
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @default(now()) @updatedAt @db.Timestamptz(3)

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("requirements_response")
}

// ---------------------------------------------------------------------------------------------
// Hardware catalog, suppliers and the advisor (Stage 4)
// ---------------------------------------------------------------------------------------------

enum ProductCategory {
  mini_pc
  refurbished_desktop
  nas
  workstation
  server
}

enum GpuClass {
  none
  integrated
  dedicated
}

enum NoiseClass {
  silent
  quiet
  normal
  loud
}

enum SupplierKind {
  retailer
  marketplace_seller
  manufacturer
  importer
  individual
}

enum OfferCondition {
  new
  refurbished
  used
}

enum Availability {
  in_stock
  limited
  on_order
  out_of_stock
  unknown
}

enum VerificationStatus {
  unverified
  verified
  rejected
}

/// A hardware model. Every spec is optional: an empty spec means "unknown", never a guess.
model Product {
  id       String          @id @default(uuid(7))
  category ProductCategory
  brand    String          @db.VarChar(80)
  model    String          @db.VarChar(120)

  cpuModel           String?     @db.VarChar(120)
  cpuCores           Int?
  /// PassMark "CPU Mark" (multi-thread) copied from the public benchmark; see cpuBenchmarkSource.
  cpuBenchmark       Int?
  cpuBenchmarkSource String?     @db.VarChar(300)
  ramGb              Int?
  ramMaxGb           Int?
  /// Drive slots (SATA bays and M.2) available for data.
  storageSlots       Int?
  /// Largest total capacity the model can hold, in TB.
  storageMaxTb       Decimal?    @db.Decimal(8, 2)
  lanPorts           Int?
  /// Speed of the fastest network port in Mbit/s (1000, 2500, 10000...).
  lanSpeedMbps       Int?
  hasWifi            Boolean?
  gpuClass           GpuClass?
  noiseClass         NoiseClass?
  idleWatts          Int?
  maxWatts           Int?
  ecc                Boolean?
  /// Manufacturer documentation the specs were taken from.
  specsSource        String?     @db.VarChar(300)
  notes              String?     @db.VarChar(2000)

  active      Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  offers     SupplierOffer[]
  quoteLines QuoteLine[]
  assets     Asset[]

  @@index([category])
  @@index([brand, model])
  @@map("product")
}

model Supplier {
  id         String       @id @default(uuid(7))
  name       String       @unique @db.VarChar(160)
  kind       SupplierKind
  wilayaCode Int?
  phone      String?      @db.VarChar(30)
  url        String?      @db.VarChar(300)
  notes      String?      @db.VarChar(1000)
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime     @default(now()) @updatedAt @db.Timestamptz(3)

  offers SupplierOffer[]

  @@map("supplier")
}

/// One observation of a price at a supplier. Immutable (database trigger): a price change is a
/// NEW row, so the price history is preserved. Only verification fields and notes can change.
model SupplierOffer {
  id                 String             @id @default(uuid(7))
  productId          String
  supplierId         String
  priceDzd           Decimal            @db.Decimal(14, 2)
  condition          OfferCondition
  availability       Availability       @default(unknown)
  warrantyMonths     Int?
  /// Wilaya where the item can be collected (1..58).
  locationWilayaCode Int?
  /// Evidence: a link to the listing/page, or a reference for a manual quotation. One is required.
  sourceUrl          String?            @db.VarChar(500)
  quoteReference     String?            @db.VarChar(160)
  /// When the price was observed at the source.
  checkedAt          DateTime           @db.Timestamptz(3)
  verificationStatus VerificationStatus @default(unverified)
  verifiedAt         DateTime?          @db.Timestamptz(3)
  verifiedById       String?
  notes              String?            @db.VarChar(1000)
  createdById        String?
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  supplier   Supplier    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  quoteLines QuoteLine[]

  @@index([productId, checkedAt(sort: Desc)])
  @@index([supplierId])
  @@index([verificationStatus])
  @@map("supplier_offer")
}

/// A saved advisor run: an immutable snapshot of the inputs, the weights and the full explained
/// ranking, so a recommendation can be shown or quoted later exactly as it was produced.
model Recommendation {
  id                  String   @id @default(uuid(7))
  leadId              String
  engineVersion       Int
  requirementsVersion Int
  inputs              Json
  results             Json
  createdById         String?
  createdAt           DateTime @default(now()) @db.Timestamptz(3)

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Restrict)

  @@index([leadId, createdAt(sort: Desc)])
  @@map("recommendation")
}

enum QuoteRevisionStatus {
  draft
  issued
  accepted
  rejected
  superseded
}

enum QuoteLineKind {
  hardware
  labor
  service
  other
}

/// A quotation for a lead. The content lives in revisions; an issued revision is an immutable
/// snapshot (see the quote_* triggers), a change is a new revision.
model Quote {
  id          String   @id @default(uuid(7))
  /// Human-facing, unique, gap-tolerant number such as Q-2026-0001.
  number      String   @unique @db.VarChar(20)
  leadId      String
  title       String   @db.VarChar(200)
  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  lead      Lead            @relation(fields: [leadId], references: [id], onDelete: Restrict)
  revisions QuoteRevision[]
  project   Project?

  @@index([leadId])
  @@index([createdAt(sort: Desc)])
  @@map("quote")
}

/// Per-year counter used to allocate quote numbers atomically.
model QuoteCounter {
  year Int @id
  last Int

  @@map("quote_counter")
}

model QuoteRevision {
  id           String              @id @default(uuid(7))
  quoteId      String
  number       Int
  status       QuoteRevisionStatus @default(draft)
  /// Terms / notes shown to the customer.
  notes        String?             @db.VarChar(2000)
  /// Set when issued: issuedAt + the configured validity.
  validUntil   DateTime?           @db.Timestamptz(3)
  issuedAt     DateTime?           @db.Timestamptz(3)
  issuedById   String?
  /// Totals are produced by the deterministic calculator (src/modules/quotes/calc.ts).
  subtotalDzd  Decimal             @default(0) @db.Decimal(14, 2)
  discountDzd  Decimal             @default(0) @db.Decimal(14, 2)
  taxDzd       Decimal             @default(0) @db.Decimal(14, 2)
  totalDzd     Decimal             @default(0) @db.Decimal(14, 2)
  /// Frozen at issue: company, customer, lines with price evidence, calculation, engine version.
  snapshot     Json?
  decidedAt    DateTime?           @db.Timestamptz(3)
  decidedById  String?
  decisionNote String?             @db.VarChar(500)
  createdById  String?
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime            @default(now()) @updatedAt @db.Timestamptz(3)

  quote Quote       @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  lines QuoteLine[]

  @@unique([quoteId, number])
  @@index([status])
  @@index([issuedAt])
  @@index([decidedAt])
  @@map("quote_revision")
}

model QuoteLine {
  id          String        @id @default(uuid(7))
  revisionId  String
  position    Int
  kind        QuoteLineKind
  description String        @db.VarChar(300)
  quantity    Decimal       @db.Decimal(12, 3)
  unitPrice   Decimal       @db.Decimal(14, 2)
  discountPct Decimal       @default(0) @db.Decimal(5, 2)
  taxRatePct  Decimal       @default(0) @db.Decimal(5, 2)
  /// What the line costs the business per unit; unknown (null) is never guessed.
  unitCost    Decimal?      @db.Decimal(14, 2)
  productId   String?
  /// The price observation the cost came from (evidence), for hardware lines.
  offerId     String?

  revision QuoteRevision  @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  product  Product?       @relation(fields: [productId], references: [id], onDelete: Restrict)
  offer    SupplierOffer? @relation(fields: [offerId], references: [id], onDelete: Restrict)

  @@unique([revisionId, position])
  @@index([productId])
  @@index([offerId])
  @@map("quote_line")
}

enum ProjectStatus {
  planned
  in_progress
  on_hold
  completed
  cancelled
}

enum TaskStatus {
  todo
  in_progress
  blocked
  done
  cancelled
}

enum TaskKind {
  survey
  rollback
  work
  test
  handover
  custom
}

/// Per-year counter used to allocate project numbers atomically.
model ProjectCounter {
  year Int @id
  last Int

  @@map("project_counter")
}

/// The execution of an accepted quotation. One project per quote (unique quoteId), which makes
/// creation idempotent.
model Project {
  id            String        @id @default(uuid(7))
  /// Human-facing number such as P-2026-0001.
  number        String        @unique @db.VarChar(20)
  quoteId       String        @unique
  leadId        String
  title         String        @db.VarChar(200)
  status        ProjectStatus @default(planned)
  managerId     String?
  startDate     DateTime?     @db.Timestamptz(3)
  targetDate    DateTime?     @db.Timestamptz(3)
  /// Required before work starts: how to get back to the previous state if it goes wrong.
  rollbackPlan  String?       @db.VarChar(4000)
  /// Recorded at handover. Never put customer passwords or VPN keys here: reference where they are kept.
  handoverNotes String?       @db.VarChar(4000)
  handoverAt    DateTime?     @db.Timestamptz(3)
  handoverById  String?
  completedAt   DateTime?     @db.Timestamptz(3)
  cancelReason  String?       @db.VarChar(300)
  createdById   String?
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @default(now()) @updatedAt @db.Timestamptz(3)

  quote           Quote               @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  lead            Lead                @relation(fields: [leadId], references: [id], onDelete: Restrict)
  manager         User?               @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  milestones      Milestone[]
  tasks           Task[]
  assets          Asset[]
  deploymentJobs  DeploymentJob[]

  @@index([leadId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("project")
}

model Milestone {
  id        String    @id @default(uuid(7))
  projectId String
  title     String    @db.VarChar(200)
  dueDate   DateTime? @db.Timestamptz(3)
  position  Int
  doneAt    DateTime? @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  tasks   Task[]

  @@index([projectId, position])
  @@map("milestone")
}

model Task {
  id          String     @id @default(uuid(7))
  projectId   String
  milestoneId String?
  kind        TaskKind   @default(custom)
  title       String     @db.VarChar(300)
  description String?    @db.VarChar(2000)
  status      TaskStatus @default(todo)
  assigneeId  String?
  dueDate     DateTime?  @db.Timestamptz(3)
  position    Int
  /// Set exactly when the status is done (CHECK constraint).
  completedAt DateTime?  @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @default(now()) @updatedAt @db.Timestamptz(3)

  project      Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  milestone    Milestone?       @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assignee     User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  checklist    ChecklistItem[]
  dependsOn    TaskDependency[] @relation("DependentTask")
  dependedOnBy TaskDependency[] @relation("PrerequisiteTask")

  @@index([projectId, position])
  @@index([assigneeId])
  @@index([status])
  @@map("task")
}

/// `taskId` cannot start or finish until `dependsOnId` is done (or cancelled).
model TaskDependency {
  taskId      String
  dependsOnId String

  task      Task @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("PrerequisiteTask", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnId])
  @@index([dependsOnId])
  @@map("task_dependency")
}

model ChecklistItem {
  id       String    @id @default(uuid(7))
  taskId   String
  text     String    @db.VarChar(300)
  position Int
  done     Boolean   @default(false)
  doneAt   DateTime? @db.Timestamptz(3)
  doneById String?

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, position])
  @@map("checklist_item")
}

enum AssetKind {
  server
  nas
  workstation
  network_device
  ups
  software_service
  subscription
  other
}

enum AssetStatus {
  active
  faulty
  retired
}

enum TicketStatus {
  open
  in_progress
  waiting_customer
  resolved
  closed
}

enum TicketPriority {
  low
  normal
  high
  urgent
}

/// Per-year counter for ticket numbers.
model TicketCounter {
  year Int @id
  last Int

  @@map("ticket_counter")
}

/// Something installed or subscribed at a customer: hardware, a service, network gear.
/// Credentials are NEVER stored here; `credentialsRef` only says where they are kept.
model Asset {
  id             String      @id @default(uuid(7))
  customerId     String
  projectId      String?
  productId      String?
  kind           AssetKind
  name           String      @db.VarChar(160)
  brand          String?     @db.VarChar(80)
  model          String?     @db.VarChar(120)
  serialNumber   String?     @db.VarChar(120)
  os             String?     @db.VarChar(120)
  version        String?     @db.VarChar(60)
  location       String?     @db.VarChar(200)
  installedAt    DateTime?   @db.Timestamptz(3)
  /// End of the hardware warranty.
  warrantyUntil  DateTime?   @db.Timestamptz(3)
  /// Renewal date of a subscription or licence.
  renewsAt       DateTime?   @db.Timestamptz(3)
  status         AssetStatus @default(active)
  /// Where the access credentials are kept (for example a password-manager item), never the secrets.
  credentialsRef String?     @db.VarChar(300)
  notes          String?     @db.VarChar(1000)
  createdById    String?
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @default(now()) @updatedAt @db.Timestamptz(3)

  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  project        Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  contracts      ContractAsset[]
  backupPolicies BackupPolicy[]
  tickets        Ticket[]
  serviceReports ServiceReport[]

  @@index([customerId])
  @@index([status])
  @@index([warrantyUntil])
  @@map("asset")
}

model MaintenanceContract {
  id            String    @id @default(uuid(7))
  customerId    String
  title         String    @db.VarChar(200)
  startsAt      DateTime  @db.Timestamptz(3)
  endsAt        DateTime  @db.Timestamptz(3)
  /// Agreed monthly fee in DZD (exact decimal); null = not stated.
  monthlyFeeDzd Decimal?  @db.Decimal(14, 2)
  notes         String?   @db.VarChar(1000)
  cancelledAt   DateTime? @db.Timestamptz(3)
  cancelReason  String?   @db.VarChar(300)
  createdById   String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  customer  Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  assets    ContractAsset[]
  schedules MaintenanceSchedule[]

  @@index([customerId])
  @@index([endsAt])
  @@map("maintenance_contract")
}

model ContractAsset {
  contractId String
  assetId    String

  contract MaintenanceContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  asset    Asset               @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([contractId, assetId])
  @@index([assetId])
  @@map("contract_asset")
}

/// A recurring visit. The next due date is computed (see src/modules/careops/rules.ts).
model MaintenanceSchedule {
  id             String    @id @default(uuid(7))
  contractId     String
  title          String    @db.VarChar(200)
  intervalMonths Int
  /// First due date.
  anchorDate     DateTime  @db.Timestamptz(3)
  lastDoneAt     DateTime? @db.Timestamptz(3)
  active         Boolean   @default(true)
  assigneeId     String?
  createdById    String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  contract       MaintenanceContract   @relation(fields: [contractId], references: [id], onDelete: Restrict)
  assignee       User?                 @relation("ScheduleAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reminders      MaintenanceReminder[]
  serviceReports ServiceReport[]

  @@index([contractId])
  @@index([active])
  @@map("maintenance_schedule")
}

/// One reminder per schedule and due date: the unique key makes generation idempotent.
model MaintenanceReminder {
  id         String   @id @default(uuid(7))
  scheduleId String
  dueDate    DateTime @db.Timestamptz(3)
  followUpId String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  schedule MaintenanceSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  followUp FollowUp?           @relation(fields: [followUpId], references: [id], onDelete: SetNull)

  @@unique([scheduleId, dueDate])
  @@map("maintenance_reminder")
}

/// A record of a visit. Append-only, like the conversation log.
model ServiceReport {
  id            String   @id @default(uuid(7))
  customerId    String
  scheduleId    String?
  ticketId      String?
  assetId       String?
  performedAt   DateTime @db.Timestamptz(3)
  performedById String?
  summary       String   @db.VarChar(2000)
  partsReplaced String?  @db.VarChar(1000)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  customer Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  schedule MaintenanceSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  ticket   Ticket?              @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  asset    Asset?               @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([customerId, performedAt(sort: Desc)])
  @@index([scheduleId])
  @@map("service_report")
}

model Ticket {
  id          String         @id @default(uuid(7))
  /// Human-facing number such as T-2026-0001.
  number      String         @unique @db.VarChar(20)
  customerId  String
  assetId     String?
  title       String         @db.VarChar(200)
  description String?        @db.VarChar(4000)
  priority    TicketPriority @default(normal)
  status      TicketStatus   @default(open)
  assigneeId  String?
  /// Required when the ticket is resolved.
  resolution  String?        @db.VarChar(2000)
  resolvedAt  DateTime?      @db.Timestamptz(3)
  closedAt    DateTime?      @db.Timestamptz(3)
  createdById String?
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @default(now()) @updatedAt @db.Timestamptz(3)

  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  asset          Asset?          @relation(fields: [assetId], references: [id], onDelete: SetNull)
  assignee       User?           @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments       TicketComment[]
  serviceReports ServiceReport[]

  @@index([customerId])
  @@index([status, priority])
  @@index([assigneeId, status])
  @@index([createdAt])
  @@index([resolvedAt])
  @@map("ticket")
}

/// Append-only discussion on a ticket.
model TicketComment {
  id        String   @id @default(uuid(7))
  ticketId  String
  authorId  String?
  body      String   @db.VarChar(2000)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@map("ticket_comment")
}

enum BackupKind {
  files
  database
  system_image
  configuration
  other
}

enum BackupOutcome {
  success
  partial
  failed
}

enum RestoreOutcome {
  success
  failed
}

enum RemotePlanStatus {
  draft
  approved
  retired
}

enum TailnetOwner {
  customer
  provider
}

/// How a customer's data is backed up. The application records the policy and what happened; it
/// never runs a backup or touches a customer system. Secrets are NEVER stored: `encryptionKeyRef`
/// only says where the key is kept.
model BackupPolicy {
  id                   String     @id @default(uuid(7))
  customerId           String
  assetId              String?
  name                 String     @db.VarChar(200)
  kind                 BackupKind
  /// A successful backup is expected at least every this many days.
  frequencyDays        Int
  retentionDays        Int?
  /// Where the copies go, in words (for example "external disk kept in the office safe").
  destination          String     @db.VarChar(300)
  /// null = not known yet.
  encrypted            Boolean?
  /// Where the encryption key is kept, never the key.
  encryptionKeyRef     String?    @db.VarChar(300)
  offsite              Boolean?
  /// A restore must be proven at least this often (FR-9).
  restoreTestEveryDays Int        @default(90)
  /// Step-by-step recovery documentation.
  recoveryProcedure    String?    @db.VarChar(4000)
  recoveryReviewedAt   DateTime?  @db.Timestamptz(3)
  active               Boolean    @default(true)
  notes                String?    @db.VarChar(1000)
  createdById          String?
  createdAt            DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime   @default(now()) @updatedAt @db.Timestamptz(3)

  customer     Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  asset        Asset?         @relation(fields: [assetId], references: [id], onDelete: SetNull)
  records      BackupRecord[]
  restoreTests RestoreTest[]

  @@index([customerId])
  @@index([active])
  @@map("backup_policy")
}

/// One backup run, as reported by the person who checked it. Append-only.
model BackupRecord {
  id           String        @id @default(uuid(7))
  policyId     String
  ranAt        DateTime      @db.Timestamptz(3)
  outcome      BackupOutcome
  sizeMb       Int?
  notes        String?       @db.VarChar(1000)
  recordedById String?
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)

  policy BackupPolicy @relation(fields: [policyId], references: [id], onDelete: Restrict)

  @@index([policyId, ranAt(sort: Desc)])
  @@map("backup_record")
}

/// A restore drill: proof that a backup can actually be restored. Append-only.
model RestoreTest {
  id              String         @id @default(uuid(7))
  policyId        String
  testedAt        DateTime       @db.Timestamptz(3)
  outcome         RestoreOutcome
  durationMinutes Int?
  notes           String?        @db.VarChar(1000)
  testedById      String?
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)

  policy BackupPolicy @relation(fields: [policyId], references: [id], onDelete: Restrict)

  @@index([policyId, testedAt(sort: Desc)])
  @@map("restore_test")
}

/// A Tailscale access plan for a customer: documentation and approval only. The application never
/// changes a customer's network or holds an auth key.
model RemoteAccessPlan {
  id               String           @id @default(uuid(7))
  customerId       String
  title            String           @db.VarChar(200)
  status           RemotePlanStatus @default(draft)
  tailnetOwner     TailnetOwner     @default(customer)
  /// Which devices connect, in words.
  devices          String?          @db.VarChar(2000)
  /// Proposed ACL / tag layout, in words.
  aclNotes         String?          @db.VarChar(4000)
  deviceApproval   Boolean          @default(false)
  keyExpiry        Boolean          @default(false)
  noPublicExposure Boolean          @default(false)
  noSubnetOrExit   Boolean          @default(false)
  mfa              Boolean          @default(false)
  /// Required to approve a plan that departs from the security policy.
  exceptions       String?          @db.VarChar(2000)
  approvedAt       DateTime?        @db.Timestamptz(3)
  approvedById     String?
  retiredAt        DateTime?        @db.Timestamptz(3)
  createdById      String?
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @default(now()) @updatedAt @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([status])
  @@map("remote_access_plan")
}

enum AiRequestStatus {
  ok
  unavailable
  invalid
  limited
  error
}

/// A log of AI assistant calls: who asked, which tool, how big, how long, what happened. It never
/// stores the prompt or the answer (they can contain customer data). Append-only.
model AiRequest {
  id          String          @id @default(uuid(7))
  userId      String?
  tool        String          @db.VarChar(60)
  status      AiRequestStatus
  provider    String?         @db.VarChar(40)
  model       String?         @db.VarChar(80)
  inputChars  Int             @default(0)
  outputChars Int             @default(0)
  latencyMs   Int             @default(0)
  /// A short machine code such as "timeout" or "rate_limited"; never a provider message.
  errorCode   String?         @db.VarChar(60)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("ai_request")
}

// ---------------------------------------------------------------------------------------------
// Deployment Automation (Stage 12)
// ---------------------------------------------------------------------------------------------

enum DeploymentProviderType {
  proxmox
  ssh_ansible
  docker_engine
  docker_compose
  nas_generic
  custom
}

enum DeploymentCredentialType {
  api_token
  ssh_key
  username_password
  oauth_token
  custom
}

enum DeploymentJobStatus {
  pending_approval
  approved
  rejected
  planned
  executing
  completed
  failed
  cancelled
  rolling_back
  rolled_back
}

enum DeploymentStepStatus {
  pending
  running
  completed
  failed
  skipped
  rolled_back
}

enum DeploymentStepKind {
  validation
  provisioning
  configuration
  verification
  rollback
  custom
}

/// A configured deployment provider (Proxmox cluster, SSH host, Docker daemon, etc.).
/// The actual credentials are stored separately and referenced by credentialId.
model DeploymentProvider {
  id          String                @id @default(uuid(7))
  name        String                @db.VarChar(100)
  type        DeploymentProviderType
  /// Base URL or endpoint (e.g., https://proxmox.example.com:8006/api2/json)
  endpoint    String                @db.VarChar(500)
  /// Provider-specific configuration (JSON)
  config      Json
  /// Whether this provider is active and can be used for new jobs
  active      Boolean               @default(true)
  /// Optional: customer this provider is scoped to (null = global/shared)
  customerId  String?
  customer    Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdById String?
  createdAt   DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime              @default(now()) @updatedAt @db.Timestamptz(3)

  credentials DeploymentCredential[]
  jobs        DeploymentJob[]

  @@index([type])
  @@index([active])
  @@index([customerId])
  @@map("deployment_provider")
}

/// Credentials for a deployment provider. Never stores raw secrets in the DB;
/// `secretRef` points to where the secret is kept (e.g., Vault path, env var name, file path).
/// The worker resolves the secret at execution time.
model DeploymentCredential {
  id           String                 @id @default(uuid(7))
  providerId   String
  type         DeploymentCredentialType
  /// Identifier for the credential (e.g., "root", "deploy-user", "api-token-prod")
  identifier   String                 @db.VarChar(100)
  /// Reference to where the actual secret is stored (NOT the secret itself)
  /// Examples: "vault:secret/data/proxmox/root", "env:PROXMOX_API_TOKEN", "file:/run/secrets/proxmox_token"
  secretRef    String                 @db.VarChar(500)
  /// Additional metadata (e.g., SSH key fingerprint, token expiry)
  metadata     Json?
  active       Boolean                @default(true)
  createdById  String?
  createdAt    DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime               @default(now()) @updatedAt @db.Timestamptz(3)

  provider DeploymentProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([active])
  @@map("deployment_credential")
}

/// A deployment job: the execution of a plan against a provider.
/// Created from a project, a manual trigger, or a scheduled task.
model DeploymentJob {
  id              String               @id @default(uuid(7))
  /// Human-facing number such as D-2026-0001
  number          String               @unique @db.VarChar(20)
  providerId      String
  customerId      String?
  projectId       String?
  /// What this job does (e.g., "Deploy Proxmox VM for customer X", "Update Docker stack")
  title           String               @db.VarChar(300)
  /// Detailed description
  description     String?              @db.VarChar(4000)
  status          DeploymentJobStatus  @default(pending_approval)
  /// The execution plan (JSON), produced by provider.plan() and reviewed before execution.
  plan            Json?
  /// Rollback plan (JSON), produced alongside the execution plan.
  rollbackPlan    Json?
  /// Who approved the job (for jobs requiring approval)
  approvedById    String?
  approvedAt      DateTime?            @db.Timestamptz(3)
  /// Who rejected the job
  rejectedById    String?
  rejectedAt      DateTime?            @db.Timestamptz(3)
  rejectionReason String?              @db.VarChar(1000)
  /// Started/completed timestamps
  startedAt       DateTime?            @db.Timestamptz(3)
  completedAt     DateTime?            @db.Timestamptz(3)
  /// Error message if failed
  errorMessage    String?              @db.VarChar(2000)
  /// Idempotency key for safe retries
  idempotencyKey  String?              @unique @db.VarChar(100)
  createdById     String?
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime             @default(now()) @updatedAt @db.Timestamptz(3)

  provider   DeploymentProvider    @relation(fields: [providerId], references: [id], onDelete: Restrict)
  customer   Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  project    Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  steps      DeploymentStep[]
  approvals  DeploymentApproval[]

  @@index([providerId])
  @@index([customerId])
  @@index([projectId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("deployment_job")
}

/// Per-year counter for deployment job numbers.
model DeploymentJobCounter {
  year Int @id
  last Int

  @@map("deployment_job_counter")
}

/// An approval record for a deployment job. Multiple approvals can be required.
model DeploymentApproval {
  id          String   @id @default(uuid(7))
  jobId       String
  /// The role or specific user required to approve (e.g., "owner", "infrastructure_engineer", "user:abc123")
  requiredBy  String   @db.VarChar(100)
  /// Who actually approved
  approvedById String?
  approvedBy   User?    @relation("DeploymentApprovalApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime? @db.Timestamptz(3)
  /// If rejected
  rejected    Boolean  @default(false)
  rejectedById String?
  rejectedBy   User?    @relation("DeploymentApprovalRejecter", fields: [rejectedById], references: [id], onDelete: SetNull)
  rejectedAt   DateTime? @db.Timestamptz(3)
  reason      String?   @db.VarChar(500)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  job DeploymentJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, requiredBy])
  @@index([jobId])
  @@map("deployment_approval")
}

/// A single step in a deployment job. Steps are executed sequentially by the worker.
model DeploymentStep {
  id          String               @id @default(uuid(7))
  jobId       String
  position    Int
  kind        DeploymentStepKind
  /// Human-readable name (e.g., "Validate Proxmox connection", "Create VM", "Configure network")
  name        String               @db.VarChar(200)
  /// Step description
  description String?              @db.VarChar(1000)
  /// Step-specific input parameters (JSON)
  input       Json?
  /// Step output/result (JSON), populated after execution
  output      Json?
  status      DeploymentStepStatus @default(pending)
  /// Error message if failed
  errorMessage String?             @db.VarChar(2000)
  /// Started/completed timestamps
  startedAt   DateTime?            @db.Timestamptz(3)
  completedAt DateTime?            @db.Timestamptz(3)
  /// Retry count
  retryCount  Int                  @default(0)
  /// Max retries allowed for this step
  maxRetries  Int                  @default(0)
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime             @default(now()) @updatedAt @db.Timestamptz(3)

  job   DeploymentJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  logs  DeploymentLog[]

  @@unique([jobId, position])
  @@index([jobId, position])
  @@index([status])
  @@map("deployment_step")
}

/// Structured log entries for a deployment step (stdout/stderr, structured events).
/// Append-only, never modified after creation.
model DeploymentLog {
  id        String   @id @default(uuid(7))
  stepId    String
  /// Log level
  level     String   @db.VarChar(20) // debug, info, warn, error
  /// Log message
  message   String   @db.VarChar(4000)
  /// Structured metadata (e.g., { "command": "ansible-playbook ...", "exitCode": 0 })
  metadata  Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  step DeploymentStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([stepId, createdAt(sort: Desc)])
  @@map("deployment_log")
}
